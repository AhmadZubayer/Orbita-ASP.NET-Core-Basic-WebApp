@model List<Orbita_ProductTrackingApp_ASP.NET_Core.Models.Product>
@{
    ViewData["Title"] = "AllProducts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Available Products: </h1>
<table class=" table table-striped">
<tr>
    <th>ID</th>
    <th>Name</th>
    <th>Price</th>
    <th>Stock</th>
</tr>

@foreach (var p in Model)
{
    <tr>
        <td>@p.Id</td>
        <td>
            <a asp-controller="Product" 
               asp-action="ProductDetails"
               asp-route-id="@p.Id">@p.Name</a></td>
        <td>@p.Price</td>
        <td>@p.Quantity</td>
    </tr>

}

</table>