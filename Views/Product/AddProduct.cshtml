@model Orbita_ProductTrackingApp_ASP.NET_Core.Models.Product

@{
    ViewData["Title"] = "AddProduct";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Add Product</h1>
<form asp-controller="Product" asp-action="AddProduct" method="post">
<div asp-validation-summary="All" class="text-danger"></div>


<div class="mb-3">
<label asp-for="Id" class="form-label"></label>
<input asp-for="Id" class="form-control" />
</div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"> PRODUCT NAME </label>
        <span asp-validation-for="Name" class="text-danger"></span>
        <input asp-for="Name" class="form-control" />
    </div>

<div class="mb-3">
@Html.LabelFor(x=> x.Price)
        @Html.ValidationMessageFor(x => x.Price, "", new { @class = "text-danger" })
        @* @Html.TextBoxFor(x => x.Price, new {@class = "form-control"}) *@
        @Html.EditorFor(x => x.Price, new { htmlAttributes = new { @class = "form-control" }})
    </div>

    <div class="mb-3">
        @Html.Label("Quantity")
        @Html.ValidationMessage("Quantity", "", new { @class = "text-danger" })
        @Html.TextBox("Quantity", Model.Quantity, new { @class = "form-control" })
    </div>

<button type="submit" class="btn btn-primary">Add Product</button>

</form>
